@model TaskAssignmentInput
@{
    var document = ViewBag.Document as DeanDocument;
    var executors = ViewBag.Executors as IReadOnlyList<AppUser> ?? [];
    ViewData["Title"] = "Орындаушы тағайындау";
}
<div class="page-toolbar"><div><h2>Орындаушы тағайындау</h2><p>@document?.RegistrationNumber · @document?.Title</p></div><a asp-controller="Documents" asp-action="Details" asp-route-id="@Model.DocumentId" class="btn btn-outline-primary">← Құжатқа қайту</a></div>
<section class="panel"><div class="panel-body">
    @if (executors.Count == 0) { <div class="db-warning">Белсенді орындаушы табылмады. Алдымен басқару панелінде Executor рөлі бар қолданушыны қосыңыз.</div> }
    <form asp-action="Assign" method="post">
        <input asp-for="DocumentId" type="hidden" /><div asp-validation-summary="ModelOnly" class="validation-summary-errors mb-3"></div>
        <div class="row g-3">
            <div class="col-lg-6"><label asp-for="UserId" class="form-label">Орындаушы *</label><select asp-for="UserId" class="form-select"><option value="">Таңдаңыз</option>@foreach (var user in executors) { <option value="@user.UserId">@user.FullName · @user.Email</option> }</select><span asp-validation-for="UserId" class="field-validation-error"></span></div>
            <div class="col-lg-6"><label asp-for="DueDate" class="form-label">Орындау мерзімі</label><input asp-for="DueDate" type="date" class="form-control" /></div>
            <div class="col-12"><label asp-for="TaskDescription" class="form-label">Тапсырма мазмұны</label><textarea asp-for="TaskDescription" class="form-control" rows="4" placeholder="Орындаушының міндетін қысқаша жазыңыз"></textarea><span asp-validation-for="TaskDescription" class="field-validation-error"></span></div>
            <div class="col-12"><label class="form-check"><input asp-for="IsPrimary" class="form-check-input"/><span class="form-check-label small-muted">Негізгі орындаушы ретінде белгілеу</span></label></div>
        </div>
        <div class="d-flex justify-content-end mt-4"><button class="btn btn-primary" type="submit">Орындаушыны тағайындау</button></div>
    </form>
</div></section>
<partial name="_ValidationScriptsPartial" />
