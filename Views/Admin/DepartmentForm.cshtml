@model DepartmentInput
@{ var edit = Model.DepartmentId.HasValue; ViewData["Title"] = edit ? "Бөлімді өңдеу" : "Бөлім қосу"; }
<div class="page-toolbar"><div><h2>@ViewData["Title"]</h2><p>Құжаттарға жауапты бөлімнің атауы.</p></div><a asp-action="Departments" class="btn btn-outline-primary">← Бөлімдер</a></div>
<section class="panel"><div class="panel-body"><form asp-action="DepartmentEdit" method="post"><input asp-for="DepartmentId" type="hidden"/><div asp-validation-summary="ModelOnly" class="validation-summary-errors mb-3"></div><div class="row g-3"><div class="col-md-8"><label asp-for="DepartmentName" class="form-label">Бөлім атауы *</label><input asp-for="DepartmentName" class="form-control"/><span asp-validation-for="DepartmentName" class="field-validation-error"></span></div><div class="col-md-4"><label asp-for="ShortName" class="form-label">Қысқа атауы</label><input asp-for="ShortName" class="form-control"/></div><div class="col-12"><label class="form-check"><input asp-for="IsActive" class="form-check-input"/><span class="form-check-label small-muted">Белсенді</span></label></div></div><div class="d-flex justify-content-end mt-4"><button class="btn btn-primary">Сақтау</button></div></form></div></section>
<partial name="_ValidationScriptsPartial" />
