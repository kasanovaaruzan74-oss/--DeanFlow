@model IReadOnlyList<DocumentType>
@{ ViewData["Title"] = "Құжат түрлері"; }
<div class="page-toolbar"><div><h2>Құжат түрлері</h2><p>Кодтар тіркеу нөмірінің басында қолданылады.</p></div><a asp-action="TypeEdit" class="btn btn-primary">＋ Құжат түрін қосу</a></div>
<section class="table-panel"><div class="data-table-wrap"><table class="data-table"><thead><tr><th>Түр атауы</th><th>Тіркеу коды</th><th>Сипаттамасы</th><th>Күйі</th><th></th></tr></thead><tbody>@foreach (var item in Model) { <tr><td>@item.TypeName</td><td><span class="doc-number">@item.Code</span></td><td>@(item.Description ?? "—")</td><td><span class="status-badge @(item.IsActive ? "is-complete" : "is-neutral")">@(item.IsActive ? "Белсенді" : "Өшірілген")</span></td><td><a asp-action="TypeEdit" asp-route-id="@item.DocumentTypeId" class="btn btn-sm btn-soft">Өңдеу</a></td></tr> }</tbody></table></div><div class="table-foot"><span>@Model.Count құжат түрі</span><span>Ескі құжаттар сақталады</span></div></section>
