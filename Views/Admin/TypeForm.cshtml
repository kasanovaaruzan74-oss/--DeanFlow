@model DocumentTypeInput
@{ var edit = Model.DocumentTypeId.HasValue; ViewData["Title"] = edit ? "Құжат түрін өңдеу" : "Құжат түрін қосу"; }
<div class="page-toolbar"><div><h2>@ViewData["Title"]</h2><p>Түрдің қысқа коды автоматты тіркеу нөмірінде қолданылады.</p></div><a asp-action="Types" class="btn btn-outline-primary">← Құжат түрлері</a></div>
<section class="panel"><div class="panel-body"><form asp-action="TypeEdit" method="post"><input asp-for="DocumentTypeId" type="hidden"/><div asp-validation-summary="ModelOnly" class="validation-summary-errors mb-3"></div><div class="row g-3"><div class="col-md-8"><label asp-for="TypeName" class="form-label">Түр атауы *</label><input asp-for="TypeName" class="form-control"/><span asp-validation-for="TypeName" class="field-validation-error"></span></div><div class="col-md-4"><label asp-for="Code" class="form-label">Коды *</label><input asp-for="Code" class="form-control" placeholder="REQ"/><span asp-validation-for="Code" class="field-validation-error"></span><div class="form-text">Тек әріп пен сан. Мысалы: REQ-2026-0001.</div></div><div class="col-12"><label asp-for="Description" class="form-label">Сипаттамасы</label><textarea asp-for="Description" class="form-control" rows="3"></textarea></div><div class="col-12"><label class="form-check"><input asp-for="IsActive" class="form-check-input"/><span class="form-check-label small-muted">Белсенді</span></label></div></div><div class="d-flex justify-content-end mt-4"><button class="btn btn-primary">Сақтау</button></div></form></div></section>
<partial name="_ValidationScriptsPartial" />
