@model IReadOnlyList<AuditLog>
@{ ViewData["Title"] = "Аудит журналы"; }
<div class="page-toolbar"><div><h2>Аудит журналы</h2><p>Кіру және жүйедегі маңызды өзгерістердің ізін қарау</p></div></div>
<form method="get" class="filter-panel"><div class="filter-grid" style="grid-template-columns:2fr repeat(3,minmax(120px,1fr)) auto"><div><label class="form-label" for="q">Іздеу</label><input class="form-control" id="q" name="q" value="@ViewBag.Query" placeholder="Қолданушы, әрекет немесе мәлімет"/></div><div><label class="form-label" for="eventType">Әрекет</label><select class="form-select" id="eventType" name="eventType"><option value="">Барлығы</option>@foreach (var item in new[] { "LOGIN", "LOGOUT", "CREATE", "UPDATE", "ARCHIVE", "RESTORE", "ASSIGN", "STATUS_CHANGE", "APPROVE", "RETURN", "REJECT", "UPLOAD" }) { <option selected="@((string?)ViewBag.EventType == item)" value="@item">@item</option> }</select></div><div><label class="form-label" for="from">Бастап</label><input class="form-control" type="date" id="from" name="from" value="@(((DateTime?)ViewBag.From)?.ToString("yyyy-MM-dd"))"/></div><div><label class="form-label" for="to">Дейін</label><input class="form-control" type="date" id="to" name="to" value="@(((DateTime?)ViewBag.To)?.ToString("yyyy-MM-dd"))"/></div><button type="submit" class="btn btn-primary">Сүзу</button></div></form>
<section class="table-panel">
    @if (Model.Count == 0) { <div class="empty-state"><strong>Аудит жазбасы табылмады</strong><p>Сүзгіні өзгертіп көріңіз.</p></div> }
    else { <div class="data-table-wrap"><table class="data-table"><thead><tr><th>Күні</th><th>Пайдаланушы</th><th>Әрекет</th><th>Нысан</th><th>Мәлімет</th><th>IP</th></tr></thead><tbody>@foreach (var item in Model) { <tr><td>@item.CreatedAt.ToString("dd.MM.yyyy HH:mm:ss")</td><td>@(item.User?.FullName ?? "Жүйе")<small class="d-block">@item.User?.Email</small></td><td><span class="status-badge is-neutral">@item.Action</span></td><td>@item.EntityName @(item.EntityId.HasValue ? $"· #{item.EntityId}" : "")</td><td>@(item.Details ?? "—")</td><td>@(item.IpAddress ?? "—")</td></tr> }</tbody></table></div> }
    <div class="table-foot"><span>@ViewBag.Total жазба · бет @ViewBag.Page / @ViewBag.PageCount</span><nav class="pagination">@if ((int)ViewBag.Page > 1) { <a asp-action="Audit" asp-route-q="@ViewBag.Query" asp-route-eventType="@ViewBag.EventType" asp-route-from="@(((DateTime?)ViewBag.From)?.ToString("yyyy-MM-dd"))" asp-route-to="@(((DateTime?)ViewBag.To)?.ToString("yyyy-MM-dd"))" asp-route-page="@((int)ViewBag.Page-1)">‹</a> }<span class="current">@ViewBag.Page</span>@if ((int)ViewBag.Page < (int)ViewBag.PageCount) { <a asp-action="Audit" asp-route-q="@ViewBag.Query" asp-route-eventType="@ViewBag.EventType" asp-route-from="@(((DateTime?)ViewBag.From)?.ToString("yyyy-MM-dd"))" asp-route-to="@(((DateTime?)ViewBag.To)?.ToString("yyyy-MM-dd"))" asp-route-page="@((int)ViewBag.Page+1)">›</a> }</nav></div>
</section>
