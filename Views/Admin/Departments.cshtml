@model IReadOnlyList<Department>
@{ ViewData["Title"] = "Бөлімдер"; }
<div class="page-toolbar"><div><h2>Бөлімдер</h2><p>Белсенді бөлімдер құжат тағайындауда қолданылады.</p></div><a asp-action="DepartmentEdit" class="btn btn-primary">＋ Бөлім қосу</a></div>
<section class="table-panel"><div class="data-table-wrap"><table class="data-table"><thead><tr><th>Бөлім</th><th>Қысқа атауы</th><th>Құрылған күні</th><th>Күйі</th><th></th></tr></thead><tbody>@foreach (var item in Model) { <tr><td>@item.DepartmentName</td><td>@(item.ShortName ?? "—")</td><td>@item.CreatedAt.ToString("dd.MM.yyyy")</td><td><span class="status-badge @(item.IsActive ? "is-complete" : "is-neutral")">@(item.IsActive ? "Белсенді" : "Өшірілген")</span></td><td><a asp-action="DepartmentEdit" asp-route-id="@item.DepartmentId" class="btn btn-sm btn-soft">Өңдеу</a></td></tr> }</tbody></table></div><div class="table-foot"><span>@Model.Count бөлім</span><span>Жоюдың орнына белсенділігін өшіріңіз</span></div></section>
