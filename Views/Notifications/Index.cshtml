@model IReadOnlyList<Notification>
@{ ViewData["Title"] = "Хабарламалар"; var unread = Model.Count(x => !x.IsRead); }
<div class="page-toolbar"><div><h2>Хабарламалар</h2><p>Тапсырмалар, келісімдер және құжат қозғалысы туралы</p></div>
    @if (unread > 0) { <form asp-action="MarkAllRead" method="post"><button class="btn btn-outline-primary" type="submit">Барлығын оқылған деп белгілеу</button></form> }
</div>
<section class="table-panel">
    @if (Model.Count == 0) { <div class="empty-state"><div class="empty-icon">♧</div><strong>Хабарлама жоқ</strong><p>Жаңа хабарламалар осы жерде көрсетіледі.</p></div> }
    else
    {
        @foreach (var item in Model)
        {
            <div class="notice-row @(!item.IsRead ? "unread" : "")"><span class="notice-dot" style="opacity:@(!item.IsRead ? 1 : 0)"></span><div class="flex-grow-1"><strong>@item.Title</strong><p>@item.Message</p><time>@item.CreatedAt.ToString("dd.MM.yyyy HH:mm")</time></div>
                @if (item.DocumentId.HasValue) { <form asp-action="MarkRead" method="post"><input type="hidden" name="id" value="@item.NotificationId"/><button class="btn btn-sm btn-soft" type="submit">Құжатты ашу →</button></form> }
                else if (!item.IsRead) { <form asp-action="MarkRead" method="post"><input type="hidden" name="id" value="@item.NotificationId"/><button class="btn btn-sm btn-soft" type="submit">Оқылды</button></form> }
            </div>
        }
    }
    <div class="table-foot"><span>@unread оқылмаған · @Model.Count көрсетілді</span><span>Тек жеке хабарламаларыңыз</span></div>
</section>
