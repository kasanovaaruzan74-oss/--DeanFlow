@model LoginInput
@{
    Layout = null;
    ViewData["Title"] = "Жүйеге кіру";
}
<!DOCTYPE html>
<html lang="kk" data-theme="light">
<head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#F8F9FC" />
    <title>Жүйеге кіру · UniDoc Space</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/unidoc.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/unidoc-atlas.css" asp-append-version="true" />
</head>
<body class="auth-page">
    <main class="auth-layout">
        <section class="auth-story" aria-label="UniDoc Space туралы">
            <a class="brand auth-brand" asp-controller="Account" asp-action="Login"><span class="brand-mark"><img src="~/images/aiu-mark.png" asp-append-version="true" alt="AIU" /></span><span class="brand-text"><strong>UniDoc <em>Space</em></strong><small>Деканаттың цифрлық құжат айналымы</small></span></a>
            <div class="auth-story-copy">
                <span class="eyebrow"><span class="eyebrow-dot"></span> БІР КЕҢІСТІК. ОРТАҚ НӘТИЖЕ.</span>
                <h1>Құжат айналымы<br />енді <span>айқын.</span></h1>
                <p>Деканаттың күнделікті жұмысын реттеп, әр құжаттың қозғалысын бір жерден бақылаңыз.</p>
                <div class="auth-benefits">
                    <div><span class="benefit-icon">01</span><span><strong>Бірізді құжат айналымы</strong><small>Кіріс, шығыс және ішкі құжаттар бір жүйеде</small></span></div>
                    <div><span class="benefit-icon">02</span><span><strong>Ашық бақылау</strong><small>Жауапты адам, мәртебе және мерзім анық көрінеді</small></span></div>
                    <div><span class="benefit-icon">03</span><span><strong>Уақытылы нәтиже</strong><small>Тапсырмалар мен келісімдер бір қадам жақын</small></span></div>
                </div>
            </div>
            <div class="auth-story-footer"><span>Құжат. Бақылау. Нәтиже.</span><span>© @DateTime.Now.Year UniDoc Space</span></div>
            <div class="auth-orbit orbit-one"></div><div class="auth-orbit orbit-two"></div><div class="auth-orbit orbit-three"></div>
            <div class="auth-art-card" aria-hidden="true"><span class="art-card-top"><span class="art-dot"></span> ҚҰЖАТ ҚОЗҒАЛЫСЫ</span><div class="art-paper"><i></i><i></i><i></i></div><span class="art-card-foot"><b>Бір кеңістік</b><small>реттелген жұмыс</small></span></div>
        </section>
        <section class="auth-form-side">
            <button class="icon-button auth-theme-toggle" id="themeToggle" type="button" aria-label="Тақырып ауыстыру" title="Жарық/қараңғы режим"><span class="auth-theme-sun" aria-hidden="true">☼</span><span class="auth-theme-moon" aria-hidden="true">☾</span></button>
            <div class="auth-mobile-brand"><a class="brand" asp-controller="Account" asp-action="Login"><span class="brand-mark"><img src="~/images/aiu-mark.png" asp-append-version="true" alt="AIU" /></span><span class="brand-text"><strong>UniDoc <em>Space</em></strong><small>Деканаттың цифрлық құжат айналымы</small></span></a></div>
            <div class="auth-form-wrap">
                <div class="auth-heading"><span class="auth-kicker">ҚОШ КЕЛДІҢІЗ</span><h2>Жұмыс кеңістігіне кіру</h2><p>Жалғастыру үшін жұмыс тіркелгіңізбен кіріңіз.</p></div>
                <form asp-action="Login" method="post" class="auth-form">
                    <input type="hidden" asp-for="ReturnUrl" />
                    <div asp-validation-summary="ModelOnly" class="validation-summary-errors mb-3" role="alert"></div>
                    <div class="auth-field"><label asp-for="Email" class="form-label">Электрондық пошта</label><div class="input-with-icon"><span class="field-leading" aria-hidden="true">@@</span><input asp-for="Email" class="form-control" autocomplete="username" placeholder="аты-жөні@@университет.kz" autofocus /></div><span asp-validation-for="Email" class="field-validation-error"></span></div>
                    <div class="auth-field"><div class="password-label"><label asp-for="Password" class="form-label">Құпиясөз</label><a href="#support">Көмек керек пе?</a></div><div class="input-with-icon"><span class="field-leading lock-mark" aria-hidden="true">●</span><input asp-for="Password" class="form-control" autocomplete="current-password" placeholder="Құпиясөзіңізді енгізіңіз" /><button class="password-toggle" type="button" data-toggle-password="Password" aria-label="Құпиясөзді көрсету">Көрсету</button></div><span asp-validation-for="Password" class="field-validation-error"></span></div>
                    <label class="form-check remember-row"><input asp-for="RememberMe" class="form-check-input" /><span class="form-check-label">Мені есте сақтау</span></label>
                    <button class="btn btn-primary auth-submit" type="submit"><span>Жүйеге кіру</span><span aria-hidden="true">→</span></button>
                </form>
                <div class="auth-security"><span class="security-mark">✓</span><span>Жеке деректері қорғалған корпоративтік орта</span></div>
                <p class="auth-help" id="support">Кіру деректерін алу үшін университет әкімшісіне хабарласыңыз.</p>
            </div>
            <div class="auth-mobile-footer">© @DateTime.Now.Year UniDoc Space <span>·</span> Құжат. Бақылау. Нәтиже.</div>
        </section>
    </main>
    <script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>
